load("@aspect_rules_js//js:defs.bzl", "js_library")

# Not a workspace package and not built here; consumers read its files as test data.
# gazelle:exclude **

filegroup(
    name = "resolve_ai_skills",
    srcs = glob(["plugins/claude/resolve-ai/skills/**"]),
)

# The js_library wrapper stays: js_test data requires JsInfo.
js_library(
    name = "resolve_ai_skills_data",
    srcs = [":resolve_ai_skills"],
    visibility = ["//packages/svc-mcp-server:__pkg__"],
)

filegroup(
    name = "plugin_tree",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
    visibility = ["//visibility:public"],
)

# Copy in the owning package so rules_js can consume the tree across package boundaries.
js_library(
    name = "plugin_tree_data",
    srcs = [":plugin_tree"],
    visibility = ["//packages/scripts:__pkg__"],
)
